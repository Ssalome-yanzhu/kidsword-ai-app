      "source": [
        "# KidsWord - English Learning App\\n",
        "运行这个笔记本来启动你的英语学习应用"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# 1. 安装依赖\\n",
        "!pip install google-generativeai gradio -q"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# 2. 配置 API Key（记得替换成你的真实 Key）\\n",
        "import os\\n",
        "os.environ['GEMINI_API_KEY'] = '你的API密钥'  # ← 替换这里\\n",
        "\\n",
        "print('✅ API Key 已配置')"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# 3. 创建应用逻辑\\n",
        "import google.generativeai as genai\\n",
        "import json\\n",
        "from typing import List, Dict\\n",
        "\\n",
        "genai.configure(api_key=os.environ['GEMINI_API_KEY'])\\n",
        "\\n",
        "# 文本生成\\n",
        "def generate_sentence(words: List[str]) -> Dict:\\n",
        "    model = genai.GenerativeModel('gemini-2.5-flash')\\n",
        "    prompt = f\\"\\"\\"Create a simple, fun English sentence for an 8-year-old child using these words: {', '.join(words)}.\\n",
        "    Return JSON with: sentence, translation (Chinese), context (for image generation).\\"\\"\\"\\n",
        "    \\n",
        "    response = model.generate_content(prompt)\\n",
        "    try:\\n",
        "        return json.loads(response.text)\\n",
        "    except:\\n",
        "        return {'sentence': response.text, 'translation': '', 'context': ''}\\n",
        "\\n",
        "# 图片生成（测试能否工作）\\n",
        "def generate_image(prompt: str) -> str:\\n",
        "    try:\\n",
        "        model = genai.GenerativeModel('gemini-2.5-flash')\\n",
        "        response = model.generate_content(f\\"Generate image: {prompt}\\")\\n",
        "        return \\"图片生成测试完成\\"\\n",
        "    except Exception as e:\\n",
        "        return f\\"图片生成失败: {str(e)}\\"\\n",
        "\\n",
        "print('✅ 应用逻辑已创建')"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# 4. 创建 Gradio 界面\\n",
        "import gradio as gr\\n",
        "\\n",
        "def process_words(words_input: str):\\n",
        "    words = [w.strip() for w in words_input.split(',')]\\n",
        "    result = generate_sentence(words)\\n",
        "    \\n",
        "    sentence = result.get('sentence', '')\\n",
        "    translation = result.get('translation', '')\\n",
        "    context = result.get('context', '')\\n",
        "    \\n",
        "    # 测试图片生成\\n",
        "    image_result = generate_image(context)\\n",
        "    \\n",
        "    return sentence, translation, image_result\\n",
        "\\n",
        "# 创建界面\\n",
        "with gr.Blocks(title=\\"KidsWord - English Learning\\") as demo:\\n",
        "    gr.Markdown(\\"# 🎈 KidsWord - 儿童英语学习\\")\\n",
        "    \\n",
        "    with gr.Row():\\n",
        "        words_input = gr.Textbox(label=\\"输入单词（用逗号分隔）\\", placeholder=\\"例如: apple, happy, play\\")\\n",
        "    \\n",
        "    generate_btn = gr.Button(\\"生成句子\\", variant=\\"primary\\")\\n",
        "    \\n",
        "    with gr.Row():\\n",
        "        sentence_output = gr.Textbox(label=\\"英文句子\\")\\n",
        "        translation_output = gr.Textbox(label=\\"中文翻译\\")\\n",
        "    \\n",
        "    image_output = gr.Textbox(label=\\"图片生成状态\\")\\n",
        "    \\n",
        "    generate_btn.click(\\n",
        "        fn=process_words,\\n",
        "        inputs=words_input,\\n",
        "        outputs=[sentence_output, translation_output, image_output]\\n",
        "    )\\n",
        "\\n",
        "# 启动应用（生成公开链接）\\n",
        "demo.launch(share=True)"
      ]
    }
  ],
